{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection-log.txt"
    },
    "tmpDir": "build/infection",
    "minMsi": 100,
    "minCoveredMsi": 100,
    "testFramework": "testo",
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `bool $strict = false,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable). Do NOT add ^ or $:
        // Infection wraps the pattern as ^-\s*REGEX$ over the removed diff line.
        // Verified 2026-11-01 by diffing the survivor lists with and without it:
        // bulkhead 6, circuit-breaker 13, json-ld 19 mutants removed, all of them
        // such signature lines; Escaped and Timed Out unchanged.
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false,
        // Off for the same reason: a ProtectedVisibility mutant on a protected method's
        // signature line is Not Covered and cannot be killed. Measured on
        // understudy-phpunit 2026-11-01: 4 of 4 such mutants were Not Covered.
        "ProtectedVisibility": false,
        "CastString": {
            "ignoreSourceCodeByRegex": [".*\\(string\\) preg_replace.*"]
        },
        // Equivalent mutants:
        //  - doVerify::92: removing this `return` in the JsonException catch falls
        //    through to `if (!is_array($data))`, where `$data` is unset (the throwing
        //    assignment never completed) → null → the same transportError() is returned.
        //  - RemoteAddrClientIpResolver::resolve::36: removing this `return null` in the
        //    RequestNotSetException catch leaves `$serverParams` undefined and falls
        //    through to `$serverParams['REMOTE_ADDR'] ?? null` — the `??` operator
        //    suppresses the undefined-variable warning and evaluates the whole expression
        //    to null either way, so `$remoteAddr` ends up null and the method still
        //    returns null via the final `!\is_string($remoteAddr) ... return null;`
        //    branch. Same return value, same call count, no observable difference —
        //    see ER-003 audit 2026-08-02.
        "ReturnRemoval": {
            "ignore": [
                "Rasuvaeff\\Yii3Recaptcha\\RecaptchaClient::doVerify::92",
                "Rasuvaeff\\Yii3Recaptcha\\RemoteAddrClientIpResolver::resolve::36"
            ]
        },
        // Equivalent: a form field's InputDataInterface::getName() is non-null via
        // FormModelInputData (its ::field() factory), so the `?? ''` fallback is
        // unreachable through the public API — removing it changes nothing.
        "Coalesce": {
            "ignore": [
                "Rasuvaeff\\Yii3Recaptcha\\Field\\RecaptchaV2Field::generateInput::81",
                "Rasuvaeff\\Yii3Recaptcha\\Field\\RecaptchaV3Field::generateInput::79"
            ]
        }
    }
}
